# ============================================================
# NODE.JS MICROSERVICES MONOREPO - ROOT GITIGNORE
# ============================================================


# ============================================================
# 1. DEPENDENCIES
# ============================================================

# Node dependencies (recursively across all microservices)
node_modules/
**/node_modules/

.agents/
.claude/
.windsurf/

# Package manager caches
.npm/
**/.npm/

.pnpm-store/
**/.pnpm-store/

.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Yarn legacy files
.yarn-integrity

# Package manager debug files
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*


# ============================================================
# 2. ENVIRONMENT VARIABLES & SECRETS
# ============================================================

# All environment files, including nested microservices
.env
.env.*
**/.env
**/.env.*

# Explicitly allow safe environment templates
!.env.example
!.env.sample
!.env.template

!**/.env.example
!**/.env.sample
!**/.env.template

# Environment-specific secrets
.env.local
.env.development
.env.production
.env.staging
.env.test

# Runtime secret files
secrets/
**/secrets/

*.secret
*.secrets

# NPM authentication/configuration files
.npmrc
**/.npmrc

# Allow sanitized npm configuration templates
!.npmrc.example
!**/.npmrc.example


# ============================================================
# 3. PRIVATE KEYS, CERTIFICATES & SECURITY MATERIAL
# ============================================================

# Private keys
*.key
*.pem
*.p12
*.pfx
*.p7b
*.p7c
*.p8
*.jks
*.keystore

# SSH credentials
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*

# Certificate directories
certs/
**/certs/

certificates/
**/certificates/

# Allow public certificate files only when explicitly needed.
# Do not commit private keys or private certificate bundles.


